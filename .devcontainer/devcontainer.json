{
  "name": "Corporate Maven platform (Java 25)",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true",
      "mavenVersion": "3.9.16"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    }
  },
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Nexus"
    }
  },
  "containerEnv": {
    "NEXUS_PASSWORD": "admin123",
    "NEXUS_INTERNAL_RELEASES_URL": "http://127.0.0.1:8081/repository/internal-artifact-releases/",
    "NEXUS_INTERNAL_SNAPSHOTS_URL": "http://127.0.0.1:8081/repository/internal-artifact-snapshots/"
  },
  "postCreateCommand": "java -version && mvn -version && docker version"
}
