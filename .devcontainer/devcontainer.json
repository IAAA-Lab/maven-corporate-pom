{
  "name": "Corporate Maven platform (Java 8)",
  "image": "mcr.microsoft.com/devcontainers/java:8-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true",
      "mavenVersion": "3.9.9"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    }
  },
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Nexus"
    }
  },
  "containerEnv": {
    "NEXUS_PASSWORD": "admin123",
    "NEXUS_RELEASES_URL": "http://127.0.0.1:8081/repository/maven-releases/",
    "NEXUS_SNAPSHOTS_URL": "http://127.0.0.1:8081/repository/maven-snapshots/",
    "NEXUS_PRODUCTS_RELEASES_URL": "http://127.0.0.1:8081/repository/products-releases/",
    "NEXUS_PRODUCTS_SNAPSHOTS_URL": "http://127.0.0.1:8081/repository/products-snapshots/"
  },
  "postCreateCommand": "java -version && mvn -version && docker version"
}
