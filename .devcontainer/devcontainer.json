{
  "name": "Corporate Maven platform (Java 8)",
  "image": "mcr.microsoft.com/devcontainers/java:8-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true",
      "mavenVersion": "3.9.9"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    }
  },
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Nexus"
    }
  },
  "postCreateCommand": "java -version && mvn -version && docker version"
}
