<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- Public artifacts go through Nexus. GitLab has a different repository id. -->
    <mirror>
      <id>nexus-public</id>
      <name>Company proxy for Maven Central</name>
      <url>${env.NEXUS_PUBLIC_URL}</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <servers>
    <server>
      <id>nexus-public</id>
      <username>${env.NEXUS_USERNAME}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>gitlab-maven</id>
      <username>gitlab-ci-token</username>
      <password>${env.CI_JOB_TOKEN}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>company-repositories</id>
      <repositories>
        <repository>
          <id>gitlab-maven</id>
          <name>Internal packages in the GitLab group</name>
          <url>${env.CI_API_V4_URL}/groups/${env.GITLAB_GROUP_ID}/-/packages/maven</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>company-repositories</activeProfile>
  </activeProfiles>
</settings>
