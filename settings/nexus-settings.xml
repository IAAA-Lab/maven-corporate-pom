<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- Maven 3.8.1+ ships a blocker that rejects HTTP remotes, including local Nexus. -->
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>external:http:*</mirrorOf>
      <name>Override default HTTP blocker for the local Nexus demo</name>
      <url>http://0.0.0.0/</url>
      <blocked>false</blocked>
    </mirror>
    <mirror>
      <id>nexus-public</id>
      <name>Nexus public group (Central proxy, corporate hosted, product hosted)</name>
      <url>http://127.0.0.1:8081/repository/maven-public/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <servers>
    <server>
      <id>nexus-public</id>
      <username>admin</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-releases</id>
      <username>admin</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>admin</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-products-releases</id>
      <username>admin</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-products-snapshots</id>
      <username>admin</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
